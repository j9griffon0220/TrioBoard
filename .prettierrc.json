{
  "plugins":
  ["prettier-plugin-tailwindcss",
    "prettier-plugin-blade"
],
  "tailwindStylesheet": "./resources/css/app.css",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "es5",
      "overrides": [
    {
      "files": "*.blade.php",
      "options": {
        "parser": "blade"
      }
    }
  ]
}
